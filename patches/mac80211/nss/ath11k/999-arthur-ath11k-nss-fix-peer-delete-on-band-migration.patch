From: Arthur build <arthur@localhost>
Subject: [PATCH] ath11k: nss: fix stuck peer when a station changes band

Seen on IPQ6018 (JDCloud RE-SS-01) with NSS offload on 2026-11-08: a client
associated to the 2.4 GHz BSS while still associated to the 5 GHz BSS of the
same SoC; after that its address could never associate again until reboot.

1. ath11k_peer_create() treats an existing peer with the same address on
   another vdev as a band transition and removed it from both the addr and
   the id rhash. The NSS reply to that peer's delete is matched by
   ath11k_nss_peer_msg_complete() through the id rhash, so it was dropped
   silently and ath11k_nss_peer_delete() timed out. Only drop the addr
   entry; peer ids are unique. Also fall back to the peer list and always
   warn when an NSS reply matches no peer.

2. __ath11k_peer_delete() returned on that timeout without sending the WMI
   peer delete, while mac80211 forgot the station and the host freed the
   peer. Firmware kept the peer, every later WMI peer create for the address
   got no peer map event ("Failed to add peer" every 3 s, holding conf_mutex
   and starving management TX for the whole radio), and vdev delete failed.
   On timeout, warn and continue with the firmware delete.

3. __ath11k_peer_delete() looked the peer up by address only, which during
   a band transition returns the peer on the other vdev and deleted its
   rhash and self AST entries. Look up the peer of the requested vdev.

diff --git a/drivers/net/wireless/ath/ath11k/nss.c b/drivers/net/wireless/ath/ath11k/nss.c
index 0b313b1..28330b3 100644
--- a/drivers/net/wireless/ath/ath11k/nss.c
+++ b/drivers/net/wireless/ath/ath11k/nss.c
@@ -486,11 +486,13 @@ static void ath11k_nss_peer_msg_complete(struct ath11k_base *ab, u32 peer_id,
 	spin_lock_bh(&ab->base_lock);
 
 	peer = ath11k_peer_find_by_id(ab, peer_id);
+	if (!peer)
+		peer = ath11k_peer_find_list_by_id(ab, peer_id);
 	if (!peer) {
 		spin_unlock_bh(&ab->base_lock);
-		if (ab->nss.debug_mode)
-			ath11k_warn(ab, "ath11k_nss: unable to complete peer msg, peer_id:%d\n",
-				    peer_id);
+		/* The waiter in ath11k_nss_peer_delete() will time out. */
+		ath11k_warn(ab, "ath11k_nss: unable to complete peer msg, peer_id:%d\n",
+			    peer_id);
 		return;
 	}
 
diff --git a/drivers/net/wireless/ath/ath11k/peer.c b/drivers/net/wireless/ath/ath11k/peer.c
index 51acbca..71f26d8 100644
--- a/drivers/net/wireless/ath/ath11k/peer.c
+++ b/drivers/net/wireless/ath/ath11k/peer.c
@@ -9,8 +9,8 @@
 #include "debug.h"
 #include "nss.h"
 
-static struct ath11k_peer *ath11k_peer_find_list_by_id(struct ath11k_base *ab,
-						       int peer_id)
+struct ath11k_peer *ath11k_peer_find_list_by_id(struct ath11k_base *ab,
+						int peer_id)
 {
 	struct ath11k_peer *peer;
 
@@ -798,8 +798,17 @@ static int __ath11k_peer_delete(struct ath11k *ar, u32 vdev_id, const u8 *addr)
 
 	reinit_completion(&ar->peer_delete_done);
 	ret = ath11k_nss_peer_delete(ar->ab, vdev_id, addr);
-	if (ret)
+	if (ret == -ETIMEDOUT) {
+		/* Bailing out here leaves the peer alive in firmware while
+		 * mac80211 forgets the station, and every later association
+		 * from this address fails. The unacknowledged NSS peer memory
+		 * is left mapped (leaked) since NSS may still reference it.
+		 */
+		ath11k_warn(ab, "nss peer %pM vdev %d delete unacknowledged, deleting in firmware anyway\n",
+			    addr, vdev_id);
+	} else if (ret) {
 		return ret;
+	}
 
 #ifdef CPTCFG_ATH11K_NSS_SUPPORT
 	mutex_lock(&ab->base_ast_lock);
@@ -807,14 +816,12 @@ static int __ath11k_peer_delete(struct ath11k *ar, u32 vdev_id, const u8 *addr)
 	mutex_lock(&ab->tbl_mtx_lock);
 	spin_lock_bh(&ab->base_lock);
 
-	peer = ath11k_peer_find_by_addr(ab, addr);
-
-	/* Fallback to peer list search if the correct peer can't be found.
-	 * Skip the deletion of the peer from the rhash since it has already
-	 * been deleted in peer add.
+	/* While a station moves between bands there are two peers with this
+	 * address and the addr rhash points at the one on the other vdev.
+	 * Look up the peer of this vdev so the other one keeps its rhash
+	 * and AST entries; removing an entry not in a rhash is a no-op.
 	 */
-	if (!peer)
-		peer = ath11k_peer_find(ab, vdev_id, addr);
+	peer = ath11k_peer_find(ab, vdev_id, addr);
 
 	if (!peer) {
 		spin_unlock_bh(&ab->base_lock);
@@ -921,9 +928,14 @@ int ath11k_peer_create(struct ath11k *ar, struct ath11k_vif *arvif,
 		}
 
 		/* Assume sta is transitioning to another band.
-		 * Remove here the peer from rhash.
+		 * Remove here the peer from the addr rhash only. Peer ids
+		 * stay unique, and NSS replies to the old peer's delete are
+		 * matched through the id rhash.
 		 */
-		ath11k_peer_rhash_delete(ar->ab, peer);
+		if (ar->ab->rhead_peer_addr)
+			ath11k_peer_rhash_remove(ar->ab, ar->ab->rhead_peer_addr,
+						 &peer->rhash_addr,
+						 &ar->ab->rhash_peer_addr_param);
 	}
 	spin_unlock_bh(&ar->ab->base_lock);
 	mutex_unlock(&ar->ab->tbl_mtx_lock);
diff --git a/drivers/net/wireless/ath/ath11k/peer.h b/drivers/net/wireless/ath/ath11k/peer.h
index 15c3fec..831ca04 100644
--- a/drivers/net/wireless/ath/ath11k/peer.h
+++ b/drivers/net/wireless/ath/ath11k/peer.h
@@ -111,6 +111,8 @@ struct ath11k_peer *ath11k_peer_find(struct ath11k_base *ab, int vdev_id,
 struct ath11k_peer *ath11k_peer_find_by_addr(struct ath11k_base *ab,
 					     const u8 *addr);
 struct ath11k_peer *ath11k_peer_find_by_id(struct ath11k_base *ab, int peer_id);
+struct ath11k_peer *ath11k_peer_find_list_by_id(struct ath11k_base *ab,
+						int peer_id);
 struct ath11k_peer *ath11k_peer_find_by_ast(struct ath11k_base *ab, int ast_index);
 void ath11k_peer_cleanup(struct ath11k *ar, u32 vdev_id);
 int ath11k_peer_delete(struct ath11k *ar, u32 vdev_id, u8 *addr);
