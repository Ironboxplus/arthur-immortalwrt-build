CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
# CONFIG_TARGET_MULTI_PROFILE is not set
# CONFIG_TARGET_ALL_PROFILES is not set
# CONFIG_TARGET_PER_DEVICE_ROOTFS is not set
# CONFIG_TESTING_KERNEL is not set
CONFIG_USE_APK=y
CONFIG_CCACHE=y
CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
# CONFIG_NSS_FIRMWARE_VERSION_11_4 is not set
CONFIG_ATH11K_MEM_PROFILE_512M=y
# CONFIG_ATH11K_MEM_PROFILE_1G is not set
# CONFIG_ATH11K_MEM_PROFILE_256M is not set
CONFIG_ATH11K_NSS_SUPPORT=y
# Compiles ath11k_dbg() in (backports ATH_DEBUG/ATH11K_DEBUG) so debug_mask works.
CONFIG_PACKAGE_ATH_DEBUG=y
# CONFIG_PACKAGE_ATH_SPECTRAL is not set
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set
# CONFIG_EASYTIER_INCLUDE_WEBCONSOLE is not set
# CONFIG_PACKAGE_tc-tiny is not set
# CONFIG_PACKAGE_ip-tiny is not set
# CONFIG_PACKAGE_mwan3 is not set
# CONFIG_PACKAGE_luci-app-mwan3 is not set
# CONFIG_PACKAGE_multidial is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_tailscale is not set
# CONFIG_PACKAGE_dockerd is not set

# nss
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-nss-ifb=y
CONFIG_PACKAGE_nss-firmware-ipq60xx=y
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_ip-full=y

# web
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-theme-argon=y

# istore
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_xz-utils=y

# easytier
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_kmod-tun=y

# operations
CONFIG_PACKAGE_luci-app-banip=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd-mod-cpu=y
CONFIG_PACKAGE_collectd-mod-interface=y
CONFIG_PACKAGE_collectd-mod-iwinfo=y
CONFIG_PACKAGE_collectd-mod-load=y
CONFIG_PACKAGE_collectd-mod-memory=y
CONFIG_PACKAGE_collectd-mod-network=y
CONFIG_PACKAGE_collectd-mod-thermal=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_smartdns=y
CONFIG_PACKAGE_luci-app-vnstat2=y
CONFIG_PACKAGE_vnstat2=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_zram-swap=y

# cli
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_ifstat=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_mtr-json=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_pigz=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_openssh-sftp-server=y

# storage
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_parted=y
