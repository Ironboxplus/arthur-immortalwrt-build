#!/bin/sh
# Use the upstream NSS path; never combine it with generic flowtable offload.
. /lib/functions.sh
config_load firewall
disable_flowtable() {
	uci set "firewall.$1.flow_offloading=0"
	uci set "firewall.$1.flow_offloading_hw=0"
}
config_foreach disable_flowtable defaults
uci commit firewall
uci -q set network.globals=globals
uci set network.globals.packet_steering='0'
uci commit network

# These are settings consumed by the selected upstream qca-nss-pbuf service.
# Do not hard-code the AX9000's 1GiB buffer sizes or CPU/NSS clock frequencies.
uci -q set pbuf.opt=pbuf
uci set pbuf.opt.memory_profile='512'
uci set pbuf.opt.stats_disable='1'
uci commit pbuf
exit 0
